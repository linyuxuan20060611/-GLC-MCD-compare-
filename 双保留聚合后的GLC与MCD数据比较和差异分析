"""比较GLC和MCD已有的九类百分比；不执行聚合或重分类。

依赖：python -m pip install numpy rasterio pyproj
两输入波段1--9均对应水体、森林、灌木与稀树草原、草地、耕地、湿地、
建设用地、裸地与稀疏植被、冰雪；值为0--100，0%是有效值。
"""
from pathlib import Path
from datetime import datetime
import csv
import numpy as np

BASE_DIR = Path(r"C:\Users\linyu\Desktop\科研\GLC_FCS30D数据\E110-E115\2010年处理结果\统一分类结果")
GLC_PATH = BASE_DIR / "统一分辨率结果（保留聚合法）" / "GLC_2010_common9_聚合到MCD_grid.tif"
MCD_PATH = BASE_DIR / "MCD12C1_2010_common9_percent_raw.tif"
OUTPUT_ROOT = GLC_PATH.parent / "比例差异分析2"

CLASS_BANDS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
NAMES = ["水体", "森林", "灌木地与稀树草原", "草地", "耕地",
         "湿地", "建设用地", "裸地与稀疏植被", "冰雪"]
INPUT_TOTAL = 100.0
COVERAGE_PATH = GLC_PATH.parent / "GLC有效面积覆盖率_on_MCD_grid.tif"
MIN_COVERAGE = 0.999
NODATA = -9999.0


def windows(width, height, size=256):
    from rasterio.windows import Window
    for row in range(0, height, size):
        for col in range(0, width, size):
            yield Window(col, row, min(size, width-col), min(size, height-row))


def same_grid(first, second):
    if (first.crs != second.crs or first.width != second.width
            or first.height != second.height
            or not np.allclose(tuple(first.transform), tuple(second.transform),
                               rtol=0, atol=1e-10)):
        raise ValueError("GLC、MCD或覆盖率文件的坐标系、行列数、像元位置不一致。")


def row_areas(src):
    """经纬线矩形在其椭球上的面积（km²），沿用原脚本。"""
    from pyproj import CRS
    crs = CRS.from_user_input(src.crs)
    t = src.transform
    if not crs.is_geographic or abs(t.b) > 1e-12 or abs(t.d) > 1e-12:
        raise ValueError("本分析使用MCD规则经纬度网格；当前坐标系或旋转不符合要求。")
    if any(abs(a.unit_conversion_factor - np.pi/180) > 1e-12
           for a in crs.axis_info[:2]):
        raise ValueError("经纬度坐标单位必须为度。")
    edges = t.f + np.arange(src.height+1) * t.e
    if np.any(np.abs(edges) > 90.000001):
        raise ValueError("栅格纬度范围超出[-90,90]。")
    geod = crs.get_geod()
    u = np.sin(np.deg2rad(np.clip(edges, -90, 90)))
    e2 = geod.f * (2-geod.f)
    if e2 < 0:
        raise ValueError("不支持长球体坐标系统。")
    if e2 == 0:
        integral = geod.a**2 * u
    else:
        e = np.sqrt(e2)
        integral = geod.a**2 * (1-e2) / 2 * (
            u / (1-e2*u*u) + np.arctanh(e*u)/e)
    area = np.abs(np.diff(integral)) * np.deg2rad(abs(t.a)) / 1e6
    if np.any(area <= 0):
        raise ValueError("像元面积必须大于0。")
    return area


def proportions(data, masks, title="GLC"):
    """对两套数据执行同样的范围、NoData和比例和检查。"""
    if data.ndim != 3 or data.shape[0] != 9:
        raise ValueError(f"{title}需要九个比例波段。")
    p = data.astype(np.float64) / INPUT_TOTAL
    valid = np.all(masks > 0, axis=0) & np.all(np.isfinite(p), axis=0)
    if np.any(valid & np.any((p < -1e-6) | (p > 1+1e-6), axis=0)):
        raise ValueError(f"有效{title}比例超出允许范围，请核对单位和NoData。")
    totals = p.sum(axis=0)
    error = np.abs(totals[valid]-1)
    maximum = float(error.max()) if error.size else 0.0
    if maximum > 1e-4:
        raise ValueError(
            f"{title}九类比例和不是100%，最大误差为{maximum*100:.6f}个百分点。"
            "请检查单位、波段和缺测值；不会强行归一化错误数据。")
    p[:, ~valid] = 0
    p = np.clip(p, 0, 1)
    if np.any(valid):
        p[:, valid] /= p[:, valid].sum(axis=0)
    return p, valid, maximum


def compare_proportions(p, q):
    """返回组成重合份额、差异份额、GLC减MCD；份额单位为0--1。"""
    delta = p-q
    overlap = np.clip(np.minimum(p, q).sum(axis=0), 0, 1)
    difference = np.clip(0.5*np.abs(delta).sum(axis=0), 0, 1)
    return overlap, difference, delta


def csv_write(path, header, rows):
    def formatted(x):
        if isinstance(x, (float, np.floating)):
            return "" if not np.isfinite(x) else f"{x:.8f}"
        return x
    with path.open("w", newline="", encoding="utf-8-sig") as file:
        writer = csv.writer(file)
        writer.writerow(header)
        writer.writerows([[formatted(x) for x in row] for row in rows])


def main():
    import rasterio
    from contextlib import ExitStack
    for path in (GLC_PATH, MCD_PATH):
        if not path.is_file():
            raise FileNotFoundError(f"找不到输入文件：{path}")
    if INPUT_TOTAL not in (1.0, 100.0):
        raise ValueError("INPUT_TOTAL只能是1或100。")
    if not 0 < MIN_COVERAGE <= 1:
        raise ValueError("MIN_COVERAGE必须在(0,1]内。")
    with ExitStack() as stack:
        stack.enter_context(rasterio.Env(GDAL_CACHEMAX=64*1024*1024))
        glc = stack.enter_context(rasterio.open(GLC_PATH))
        mcd = stack.enter_context(rasterio.open(MCD_PATH))
        for title, src in (("GLC", glc), ("MCD", mcd)):
            print(f"{title}：{src.name}\n波段数：{src.count}；说明：{src.descriptions}")
            if src.count != 9 or src.crs is None:
                raise ValueError(f"{title}必须是有坐标系、按九类顺序排列的九波段比例文件。")
            if src.nodata == 0:
                raise ValueError(f"{title}的NoData不能设为0，因为0%是有效比例。")
        same_grid(glc, mcd)
        area_by_row = row_areas(mcd)
        cover = None
        if COVERAGE_PATH is not None:
            cover = stack.enter_context(rasterio.open(COVERAGE_PATH))
            same_grid(cover, mcd)
            if cover.count != 1:
                raise ValueError("有效面积覆盖率文件必须是单波段。")
        else:
            print("未提供覆盖率：按整格等效面积统计。", flush=True)

        # 先检查全部输入；尚未创建输出文件。
        max_errors = [0.0, 0.0]
        for window in windows(mcd.width, mcd.height):
            for j, (title, src) in enumerate((("GLC", glc), ("MCD", mcd))):
                _, _, err = proportions(src.read(CLASS_BANDS, window=window),
                                        src.read_masks(CLASS_BANDS, window=window), title)
                max_errors[j] = max(max_errors[j], err)
            if cover is not None:
                cv = cover.read(1, window=window)
                cm = cover.read_masks(1, window=window) > 0
                if np.any(cm & (~np.isfinite(cv) | (cv < 0) | (cv > 100.0001))):
                    raise ValueError("有效面积覆盖率必须在0--100范围内。")

        output = OUTPUT_ROOT / datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        output.mkdir(parents=True, exist_ok=False)
        profile = dict(driver="GTiff", width=mcd.width, height=mcd.height,
                       transform=mcd.transform, crs=mcd.crs, count=1,
                       dtype="float32", nodata=NODATA, compress="DEFLATE", predictor=3)
        # 单独管理输出句柄，确保完成提示前所有栅格已经关闭。
        with ExitStack() as out_stack:
            matching_out = out_stack.enter_context(rasterio.open(output / "对应类别比例_pct.tif", "w", **profile))
            diff_out = out_stack.enter_context(rasterio.open(output / "差异比例_pct.tif", "w", **profile))
            delta_out = out_stack.enter_context(rasterio.open(
                output / "各类比例差_GLC减MCD_百分点.tif", "w", **{**profile, "count": 9}))
            matching_out.set_band_description(1, "九类组成重合比例：sum(min(GLC,MCD))，百分数")
            diff_out.set_band_description(1, "九类组成差异比例：半L1距离，百分数")
            for k, name in enumerate(NAMES, 1):
                delta_out.set_band_description(k, f"{name}_GLC减MCD_百分点")
            n_valid = 0
            total_area = 0.0
            match_sum = 0.0
            match_area_sum = 0.0
            glc_area = np.zeros(9)
            mcd_area = np.zeros(9)
            overlap_area = np.zeros(9)
            absolute_error_sum = np.zeros(9)
            square_error_sum = np.zeros(9)
            for number, window in enumerate(windows(mcd.width, mcd.height), 1):
                p, valid, _ = proportions(glc.read(CLASS_BANDS, window=window),
                                          glc.read_masks(CLASS_BANDS, window=window), "GLC")
                q, mcd_valid, _ = proportions(mcd.read(CLASS_BANDS, window=window),
                                              mcd.read_masks(CLASS_BANDS, window=window), "MCD")
                valid &= mcd_valid
                r = int(window.row_off)
                weights = np.broadcast_to(area_by_row[r:r+int(window.height), None], valid.shape).copy()
                if cover is not None:
                    coverage = cover.read(1, window=window).astype(np.float64)/100
                    valid &= ((cover.read_masks(1, window=window) > 0)
                              & np.isfinite(coverage) & (coverage >= MIN_COVERAGE))
                    weights *= np.clip(coverage, 0, 1)
                overlap, difference, delta = compare_proportions(p, q)
                match = np.full(valid.shape, NODATA, dtype=np.float32)
                diff = np.full(valid.shape, NODATA, dtype=np.float32)
                delta_raster = np.full(p.shape, NODATA, dtype=np.float32)
                match[valid] = overlap[valid]*100
                diff[valid] = difference[valid]*100
                delta_raster[:, valid] = delta[:, valid]*100
                matching_out.write(match, 1, window=window)
                diff_out.write(diff, 1, window=window)
                delta_out.write(delta_raster, window=window)
                w = weights[valid]
                n_valid += int(valid.sum())
                total_area += float(w.sum())
                match_sum += float(overlap[valid].sum())
                match_area_sum += float((overlap[valid]*w).sum())
                glc_area += (p[:, valid]*w).sum(axis=1)
                mcd_area += (q[:, valid]*w).sum(axis=1)
                overlap_area += (np.minimum(p[:, valid], q[:, valid])*w).sum(axis=1)
                absolute_error_sum += (np.abs(delta[:, valid])*w).sum(axis=1)
                square_error_sum += (delta[:, valid]**2*w).sum(axis=1)
                if number % 10 == 0:
                    print(f"已处理{number}块", flush=True)

        if n_valid == 0:
            raise ValueError(f"没有共同有效格网；{output}中的栅格全为NoData，不能作为结果。")
        score = match_area_sum/total_area*100
        area_label = "有效覆盖面积" if cover is not None else "整格等效面积"
        csv_write(output / "类别面积对比.csv",
                  ["类别", f"MCD_{area_label}_km2", f"GLC_{area_label}_km2", "GLC减MCD_km2"],
                  [[name, mcd_area[k], glc_area[k], glc_area[k]-mcd_area[k]]
                   for k, name in enumerate(NAMES)])
        csv_write(output / "各类比例差异统计.csv",
                  ["类别", "MCD面积加权平均比例_pct", "GLC面积加权平均比例_pct",
                   "平均差_GLC减MCD_百分点", "MAE_百分点", "RMSE_百分点", "组成重合等效面积_km2"],
                  [[name, mcd_area[k]/total_area*100, glc_area[k]/total_area*100,
                    (glc_area[k]-mcd_area[k])/total_area*100,
                    absolute_error_sum[k]/total_area*100,
                    np.sqrt(square_error_sum[k]/total_area)*100, overlap_area[k]]
                   for k, name in enumerate(NAMES)])
        csv_write(output / "总体指标.csv", ["指标", "数值"], [
            ["共同有效格网数", n_valid], [f"统计{area_label}_km2", total_area],
            ["格网平均对应比例_pct", match_sum/n_valid*100],
            ["面积加权对应比例_pct", score], ["面积加权差异比例_pct", 100-score],
            ["GLC九类比例和最大误差_百分点", max_errors[0]*100],
            ["MCD九类比例和最大误差_百分点", max_errors[1]*100],
        ])
        (output / "结果说明.txt").write_text(
            f"GLC：{GLC_PATH}\nMCD：{MCD_PATH}\n波段对应：{list(zip(CLASS_BANDS,NAMES))}\n"
            f"输入比例合计：{INPUT_TOTAL}；覆盖率：{COVERAGE_PATH}；阈值：{MIN_COVERAGE}\n"
            "每格对应比例=sum_k min(GLC_k,MCD_k)，差异比例=0.5*sum_k abs(GLC_k-MCD_k)。\n"
            "以上公式份额用0--1，输出乘100为百分数；类别比例差为GLC减MCD，单位百分点。\n"
            "两套组成完全相同时对应比例为100%；MCD某类占100%时退化为旧标签比较公式。\n"
            "面积加权方式沿用原脚本，使用同一共同有效格网，权重为格点面积乘GLC覆盖率。\n"
            "覆盖率不足的格点排除；MCD比例代表完整格点，近完整覆盖筛选减小支持范围差异。\n"
            "0%是有效值，-9999是NoData；比例和仅修正通过校验的微小浮点误差。\n"
            "无覆盖率时使用整格等效面积；有覆盖率时MCD组成按有效面积缩放，属于等效面积估计。\n"
            "组成重合不证明格点内部同类地物在空间上重叠，也不是相对于真实地表的分类精度。\n"
            "原按MCD标签分组的组成表和交叉表不再生成，改为各类比例差异统计；"
            "仅凭两套格点边际比例无法确定真实类别混淆矩阵。\n"
            "本次对应比例含义与旧单标签结果不同，不能将指标升降直接解释为产品质量变化。\n"
            "完成：全部结果已写入并关闭。\n",
            encoding="utf-8")
        print(f"完成：面积加权对应比例{score:.3f}%\n结果目录：{output}", flush=True)


if __name__ == "__main__":
    main()
